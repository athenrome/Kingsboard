{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      }
    }
  },
  "DatabaseSettings": {
    "ConnectionString": "Data Source=kingsboard.db"
  },
  "TurnSettings": {
    "TurnDurationSeconds": 4
  },
  "ChatSettings": {
    "MaxMessageLength": 256,
    "MaxUsernameLength": 24,
    "HistorySize": 50,
    "MaxStoredMessages": 1000,
    "MinSecondsBetweenMessages": 0.25
  },
  "BoardSettings": {
    "Width": 128,
    "Depth": 128,
    "Height": 8,
    "DefaultSectionSize": 24,
    "MaxSectionSize": 64,
    "Seed": null
  },
  "PawnSettings": {
    "Count": 8,
    "SpawnAreaSize": 24,
    "MaxClimb": 1,
    "HandSize": 5,
    "StartingDeck": [ "move", "move", "move", "say-number", "say-colour", "say-hello" ],
    "Seed": null
  },
  "PlayerSettings": {
    "PawnsPerPlayer": 2,
    "MaxNameLength": 24
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}
