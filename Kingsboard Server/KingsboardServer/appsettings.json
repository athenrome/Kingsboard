{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Warning",
      }
    }
  },
  "TurnSettings": {
    "TurnDurationSeconds": 4
  },
  "ChatSettings": {
    "MaxMessageLength": 256,
    "MaxUsernameLength": 24,
    "HistorySize": 50,
    "MaxStoredMessages": 1000,
    "MinSecondsBetweenMessages": 0.25
  },
  "BoardSettings": {
    "Width": 16,
    "Depth": 16,
    "Height": 6,
    "Seed": null
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}
